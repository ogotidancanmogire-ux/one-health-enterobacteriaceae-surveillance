# ==============================================================================
# ADVANCED SURVEILLANCE MODULE: CROSS-SECTOR AMR RESISTOME MAPPING
# ==============================================================================
# 1. Construct a comprehensive One Health profile dataset
# This simulates the exact downstream output of your ABRicate / Staramr runs
surveillance_matrix <- tibble(
Isolate_ID   = c("LOCAL_RUN_01", "SRR12455912", "SRR12455913", "SRR19882341", "SRR19882342"),
Sector       = c("Animal (Poultry)", "Human (Clinical)", "Human (Clinical)", "Environmental", "Animal (Dairy)"),
County       = c("Kericho", "Nairobi", "Nairobi", "Kisumu", "Kericho"),
Species      = c("Escherichia coli", "Escherichia coli", "Klebsiella pneumoniae", "Escherichia coli", "Escherichia coli"),
Beta_Lactam  = c("blaCTX-M-15", "blaCTX-M-15", "blaNDM-1", "blaCTX-M-15", "blaTEM-1"),
Colistin_mcr = c("mcr-1", "None", "None", "mcr-1", "None"),
Plasmid_Inc  = c("IncFII", "IncFII", "IncX4", "IncFII", "IncFIB")
)
cat("\n==================================================\n")
cat("      RUNNING INTERACTIVE MOLECULAR PROFILING      \n")
cat("==================================================\n")
# 2. Programmatic Query: Locate high-risk Mobile Cross-Sector Transmission flags
# We are filtering for cases where the exact same plasmid-borne resistance marker spans different sectors
shared_transmission_clones <- surveillance_matrix %>%
filter(Beta_Lactam == "blaCTX-M-15") %>%
select(Isolate_ID, Sector, County, Species, Plasmid_Inc)
print(shared_transmission_clones)
# 3. Generate an Epidemiological Surveillance Plot
cat("\nGenerating One Health Resistome distribution plot...\n")
resistome_plot <- ggplot(surveillance_matrix, aes(x = Sector, fill = Beta_Lactam)) +
geom_bar(position = "dodge", color = "#1D3557", width = 0.6) +
scale_fill_brewer(palette = "Set2") +
labs(
title = "Distribution of Critical Extended-Spectrum Beta-Lactamase (ESBL) Markers",
subtitle = "Comparative Screening Across the Human-Animal-Environmental Interface in Kenya",
x = "One Health Sector Border",
y = "Isolate Count Detection",
fill = "Genomic Marker Detected"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 12, color = "#1D3557"),
panel.grid.minor = element_blank()
)
# Save the plot out cleanly to your directory
ggsave("one_health_resistome_distribution.png", plot = resistome_plot, width = 7, height = 4, dpi = 300)
cat("[Success] Surveillance matrix visualization saved to disk!\n")
