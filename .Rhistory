# ==============================================================================
# ONE HEALTH ENTEROBACTERIACEAE GENOMIC SURVEILLANCE PIPELINE
# ==============================================================================
# AUTHOR: Ogoti Duncan Mogire
# TARGET: Assembly Validation, GC Profiling, and Surveillance Integration
# ==============================================================================
# Load required core bioinformatic and visualization libraries
library(Biostrings)
library(tidyverse)
library(scales)
# 1. SET WORKSPACE AND FILE PATHS
setwd("D:/exerciseR/")
assembly_file <- "contigs.fasta"
cat("==================================================\n")
cat(" LOADING COMPLETED ENTEROBACTERIACEAE ASSEMBLY... \n")
cat("==================================================\n")
if (!file.exists(assembly_file)) {
stop("Error: contigs.fasta not found! Wait for SPAdes to finish and copy the file over.")
}
# 2. READ MULTI-FASTA GENOMIC SEQUENCES
dna_sequences <- readDNAStringSet(assembly_file)
# 3. COMPUTE ADVANCED ASSEMBLY METRICS (N50, L50, GC%)
contig_lengths <- sort(width(dna_sequences), decreasing = TRUE)
total_assembly_length <- sum(contig_lengths)
cumulative_lengths <- cumsum(contig_lengths)
# Calculate the exact N50 and L50 indexes
n50_index <- which(cumulative_lengths >= total_assembly_length / 2)[1]
n50_value <- contig_lengths[n50_index]
l50_value <- n50_index
# Calculate Global GC Content
total_bases <- sum(alphabetFrequency(dna_sequences)[, c("A", "C", "G", "T")])
gc_bases <- sum(alphabetFrequency(dna_sequences)[, c("G", "C")])
global_gc_percentage <- (gc_bases / total_bases) * 100
# Print structural diagnostics to console
cat(sprintf("Total Contigs Assembled : %d\n", length(contig_lengths)))
cat(sprintf("Total Genome Size       : %.2f Mb\n", total_assembly_length / 1e6))
cat(sprintf("Assembly N50 Metric     : %d bp\n", n50_value))
cat(sprintf("Assembly L50 Metric     : %d contigs\n", l50_value))
cat(sprintf("Global Genomic GC%%       : %.2f%%\n", global_gc_percentage))
cat("--------------------------------------------------\n")
# 4. GENERATE HIGH-RESOLUTION SURVEILLANCE GRAPHICS
cat("Generating structural publication-ready quality plots...\n")
# Build data frame for cumulative assembly curve representation
plot_data <- tibble(
Contig_Index = 1:length(contig_lengths),
Contig_Length = contig_lengths,
Cumulative_Length = cumulative_lengths / 1e6 # Convert to Megabases
)
# Render Cumulative Assembly Curve
cumulative_curve <- ggplot(plot_data, aes(x = Contig_Index, y = Cumulative_Length)) +
geom_line(color = "#008080", linewidth = 1.2) +
geom_area(fill = "#008080", alpha = 0.1) +
geom_vline(xintercept = l50_value, linetype = "dashed", color = "#E63946", linewidth = 0.8) +
geom_hline(yintercept = (total_assembly_length / 2) / 1e6, linetype = "dashed", color = "#E63946", linewidth = 0.8) +
labs(
title = "One Health Enterobacteriaceae Assembly Continuity",
subtitle = paste("Genome Size:", round(total_assembly_length/1e6, 2), "Mb | N50:", n50_value, "bp | L50:", l50_value),
x = "Contig Index (Sorted by Size Descending)",
y = "Cumulative Assembly Size (Mb)",
caption = "Source: Genomic Surveillance Pipeline | National Museums of Kenya Hub"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", size = 14, color = "#1D3557"),
panel.grid.minor = element_blank()
)
# Save visualization directly to disk for GitHub showcase
ggsave("cumulative_assembly_curve.png", plot = cumulative_curve, width = 8, height = 5, dpi = 300)
cat("[Success] Quality graphics written to 'cumulative_assembly_curve.png'!\n")
cat("==================================================\n")
# Conceptualizing an R table to overlay your local data against public Kenyan isolates
one_health_metadata <- tibble(
Isolate_ID = c("LOCAL_RUN_01", "SRR12455912", "SRR12455913", "SRR19882341"),
Host_Source = c("Poultry Farm (Fecal Swab)", "Human Clinical (Blood)", "Human Clinical (Urine)", "River Water Downstream"),
County = c("Kericho", "Nairobi", "Nairobi", "Kisumu"),
Species = c("Escherichia coli", "Escherichia coli", "Klebsiella pneumoniae", "Escherichia coli"),
Project_Context = c("Your Current Work", "Public SRA Dataset", "Public SRA Dataset", "Public SRA Dataset")
)
print(one_health_metadata)
